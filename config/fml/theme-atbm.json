{
  "version": 1,
  "extends": "builtin:default",
  "windowIcon": "atbm_icon.png",
  "colorScheme": {
    "screenBackground": "#140a24",
    "text": "#ffffff"
  },
  "loadingScreen": {
    "background": {
      "centerHorizontally": false,
      "centerVertically": false,
      "font": "default",
      "maintainAspectRatio": false,
      "type": "image",
      "visible": true,
      "left": 0.0,
      "top": 0.0,
      "right": 0.0,
      "bottom": 0.0,
      "texture": {
        "resource": "atbm_loading_bg.png",
        "scaling": {
          "type": "stretch",
          "width": 1920,
          "height": 1080,
          "linearScaling": true
        }
      }
    },
    "mojangLogo": {
      "visible": false,
      "maintainAspectRatio": true,
      "top": 96.0,
      "centerHorizontally": true,
      "centerVertically": false,
      "font": "default"
    },
    "progressBars": {
      "labelGap": 4,
      "barGap": 5,
      "visible": true,
      "maintainAspectRatio": false,
      "left": 220.0,
      "top": 380.0,
      "right": 220.0,
      "centerHorizontally": false,
      "centerVertically": false,
      "font": "default"
    },
    "startupLog": {
      "visible": false,
      "maintainAspectRatio": true,
      "left": 10.0,
      "bottom": 10.0,
      "centerHorizontally": false,
      "centerVertically": false,
      "font": "default"
    },
    "decoration": {
      "fox": {
        "type": "image",
        "texture": {
          "resource": "fox_running.png",
          "scaling": {
            "type": "stretch",
            "width": 151,
            "height": 128,
            "linearScaling": false
          },
          "animation": {
            "frameCount": 28
          }
        },
        "visible": false,
        "maintainAspectRatio": true,
        "right": 10.0,
        "bottom": "1.0rem",
        "centerHorizontally": false,
        "centerVertically": false,
        "font": "default"
      }
    }
  }
}